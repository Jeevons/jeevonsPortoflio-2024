// Schéma Prisma — Story 4.1 (pivot Epic 4).
// Périmètre STRICT : uniquement Project / Highlight / Stack + enums.
// TimelineEntry/Hobby → 4.2 · SiteSetting → 4.3 · Media/User/… → Epic 5.
// Ne PAS déclarer de relation vers Media (inexistant) : cover/coverId
// seront ajoutés par migration en Epic 5 (décision Jeevons, story 4.1).

generator client {
  provider = "prisma-client"
  // Prisma 7 : le générateur "prisma-client" (ESM) exige un output explicite.
  // Généré hors de src/ pour ne pas polluer le code applicatif, et gitignoré.
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 : l'URL de connexion ne vit plus ici. Elle est fournie à Migrate
  // via prisma.config.ts (datasource.url) et au runtime via un driver adapter
  // passé au constructeur PrismaClient (voir src/lib/db.ts).
  provider = "postgresql"
}

// Story 5.1 — Rôle du compte admin. Volontairement mono-valeur (surface
// d'attaque minimale : un seul compte seedé, zéro inscription). D'autres rôles
// pourront s'ajouter par migration additive si le besoin apparaît.
enum Role {
  ADMIN
}

enum ProjectCategory {
  FLAGSHIP
  PERSONAL
  LAB
}

enum SkillLevel {
  LEARNING
  COMFORTABLE
  STRONG
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  category    ProjectCategory
  company     String
  title       String
  description String?         @db.Text
  period      String // ex. "Janvier - 2024"
  sortOrder   Int             @default(0)
  published   Boolean         @default(false)
  link        String?
  repoUrl     String?
  // cover/coverId : ajoutés en Epic 5 avec le modèle Media (story 4.1, décision).
  highlights  Highlight[]
  stacks      Stack[]         @relation("ProjectStacks")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, sortOrder])
}

// Story 5.1 — Compte administrateur du back-office. UNIQUE et seedé (aucune
// inscription : PLAN §3.1, REGISTRATION_OPEN=false). `passwordHash` = argon2id,
// jamais réversible ni stocké en clair (AC1).
//
// Story 5.3 — Champs 2FA (TOTP obligatoire, PLAN §9.1) ajoutés par migration
// additive. Tous NULLABLE : le compte seedé démarre sans second facteur
// (totpEnabledAt = null → enrôlement forcé au 1er login, AC1).
//  - totpSecret    : secret base32 CHIFFRÉ au repos (AES-256-GCM, clé dérivée
//                    d'AUTH_SECRET — AC5). Persisté dès la génération ; sa seule
//                    présence n'active PAS la 2FA (anti-lock-out, AC4).
//  - totpEnabledAt : null = 2FA pas encore confirmée. Posé UNIQUEMENT après un
//                    premier code TOTP valide (AC4). Sert de point de décision
//                    au guard de redirection forcée (AC2).
//  - recoveryCodes : champ créé ici, REMPLI depuis la story 5.4.
//
// Story 5.4 — `recoveryCodes` contient un tableau `[{ hash, usedAt }]` de 8
// entrées (voir src/lib/auth/recovery-codes.ts, SOURCE UNIQUE de sa lecture et
// de son écriture) :
//  - hash   : code de secours haché ARGON2ID — jamais lisible en base (AC2) ;
//  - usedAt : null tant que le code est disponible, horodatage ISO une fois
//             consommé. Les codes utilisés sont CONSERVÉS (usage unique
//             définitif + décompte des restants, AC3).
// Aucune migration : le champ Json? existant accueille cette forme telle quelle.
// Story 5.5 — `totpLastCounter` : dernier pas RFC 6238 (time step) consommé par
// un code TOTP validé. ANTI-REJEU (AC4) : à la vérification suivante, otplib
// refuse tout code dont le pas est ≤ à cette valeur — un code déjà utilisé est
// donc mort, même encore dans sa fenêtre de validité, et le rejeu reste bloqué
// d'une session à l'autre comme après un redémarrage du conteneur (ce qu'un
// compteur en mémoire n'aurait pas garanti). Nullable : aucun code consommé
// avant la première connexion en deux temps.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  role            Role      @default(ADMIN)
  totpSecret      String?
  totpEnabledAt   DateTime?
  totpLastCounter Int?
  recoveryCodes   Json?
  createdAt       DateTime  @default(now())
}

model Highlight {
  id        String  @id @default(cuid())
  label     String
  sortOrder Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Stack {
  id       String      @id @default(cuid())
  name     String      @unique
  iconKey  String?
  level    SkillLevel?
  projects Project[]   @relation("ProjectStacks")
}

// Story 4.2 — Parcours (rendu par Testimonials.tsx, id="parcours").
model TimelineEntry {
  id        String  @id @default(cuid())
  slug      String  @unique // clé naturelle : idempotence du seed + jointure avatar
  title     String
  place     String
  body      String  @db.Text
  // avatarId : le modèle Media n'existe qu'en Epic 5. Pas de relation ici ;
  // l'avatar reste un import statique joint par `slug` dans le conteneur (4.2, décision).
  avatarId  String?
  startYear Int
  endYear   Int?
  sortOrder Int     @default(0)
  published Boolean @default(true)

  @@index([published, sortOrder])
}

// Story 4.2 — Centres d'intérêt (rendus par About.tsx). Pas de `published`
// (modèle §2.1 : les hobbies sont toujours affichés).
model Hobby {
  id        String @id @default(cuid())
  slug      String @unique // clé naturelle : idempotence du seed
  title     String
  emoji     String
  posLeft   String
  posTop    String
  sortOrder Int    @default(0)
}

// Story 4.3 — Réglages éditables du site (textes Hero, badge, liens sociaux,
// e-mail fragmenté). `key @id` : la clé EST l'identifiant → seed idempotent
// trivial par upsert. `value Json` : valeur structurée (string, { url },
// { text }, ou { user, host } pour l'e-mail anti-moisson).
// Contrat de clés consommé par /admin/settings en Epic 5.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
